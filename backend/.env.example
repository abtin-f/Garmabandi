# ═══════════════════════════════════════════════════════════
#  تنظیمات محیطی — این فایل را به نام .env کپی کن و پر کن
# ═══════════════════════════════════════════════════════════
PORT=3001

# ─── دیتابیس MySQL (از cPanel بردار) ───
DB_HOST=localhost
DB_PORT=3306
DB_NAME=deeppeed_garmabandi
DB_USER=deeppeed_garmin
DB_PASS=رمز_دیتابیس_را_اینجا_بگذار

# ─── کلیدهای امنیتی — حتماً عوض کن ───
JWT_SECRET=یک_رشته_تصادفی_طولانی_و_غیرقابل_حدس
ADMIN_SECRET=رمز_ساخت_ادمین_را_عوض_کن


# ─── پنل پیامک sms.ir (کد تایید شماره موبایل) ───
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_PARAM_NAME=CODE
SMS_LINE_NUMBER=
# verify = ارسال سریع با قالب از خط خدماتی مشترک sms.ir (پیش‌فرض و توصیه‌شده)
# line   = ارسال از خط اختصاصی خودت — فقط بعد از «خدماتی‌سازی» خط،
#          وگرنه پیامک به کسانی که پیامک تبلیغاتی را مسدود کرده‌اند نمی‌رسد
SMS_SEND_MODE=verify
OTP_DEV_MODE=false
# اعتبار کد تایید به دقیقه (پیش‌فرض ۱۰، بازه‌ی مجاز ۱ تا ۳۰)
OTP_TTL_MINUTES=10

# ─── قالب‌های پیامک اطلاع‌رسانی سفارش ───
# حالت verify فقط قالبِ تأییدشده می‌فرستد، نه متن آزاد. پس هر پیام یک
# قالب جدا در app.sms.ir لازم دارد. اگر خالی بماند پیام فقط لاگ می‌شود
# و جریان کار متوقف نمی‌شود.
#   ADMIN_RECEIPT → پارامترها: NAME , AMOUNT
#   ORDER_OK      → پارامتر:   TITLE
#   ORDER_NO      → پارامتر:   TITLE
SMS_TPL_ADMIN_RECEIPT=
SMS_TPL_ORDER_OK=
SMS_TPL_ORDER_NO=
# شماره‌ای که هشدار «فیش جدید» به آن می‌رود
ADMIN_ALERT_PHONE=

# ─── پرداخت کارت‌به‌کارت ───
CARD_NUMBER=6037997569787815
CARD_HOLDER=سحر نقوی
CARD_BANK=بانک ملی ایران
# مهلت پرداخت سفارش (ساعت) — بعد از آن سفارش منقضی می‌شود
ORDER_TTL_HOURS=24
# مهلتی که به کاربر برای بررسی فیش اعلام می‌شود (ساعت) — فقط متن UI
REVIEW_SLA_HOURS=12
